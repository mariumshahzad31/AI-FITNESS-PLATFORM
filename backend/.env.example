# Local Windows development. PostgreSQL is published on host port 5433.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@localhost:5433/ai_fitness
FRONTEND_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=30000

# Local-only development secrets. Generate independent random secrets for production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# Optional custom OpenStreetMap Overpass endpoint
# OVERPASS_URL=https://overpass-api.de/api/interpreter
